[Unit]
Description=Sovrn Auth Service (Policy Engine)
After=sovrnd.service
Requires=sovrnd.service
PartOf=sovrn.target

[Service]
Type=simple
ExecStart=/usr/bin/sovrn-auth
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=sovrn.target
