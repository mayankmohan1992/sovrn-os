[Unit]
Description=Sovrn DHT Service (Distributed Hash Table)
After=network.target yggdrasil.service
Requires=yggdrasil.service
PartOf=sovrn.target

[Service]
Type=notify
ExecStart=/usr/bin/sovrn-dht --config /etc/sovrn/dht.toml
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sovrn/dht /var/lib/sovrn/sockets

Environment=SOVRN_SOCKET_DIR=/var/lib/sovrn/sockets

[Install]
WantedBy=sovrn.target
