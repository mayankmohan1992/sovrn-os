#!/bin/bash
# Sovrn OS Installer — copies the running system to a target disk
# Requires: zenity, rsync, parted, grub-install
set -euo pipefail

[ "$(id -u)" -eq 0 ] || { zenity --error --text="Run this as root: sudo sovrn-install"; exit 1; }

for cmd in parted rsync grub-install mkfs.ext4 mkfs.fat losetup; do
    command -v "$cmd" >/dev/null 2>&1 || { zenity --error --text="Missing: $cmd"; exit 1; }
done

if ! zenity --question --title="Sovrn OS Installer" \
    --text="This will DESTROY ALL DATA on the selected disk.\nBack up any important files first.\n\nProceed?" --no-wrap; then
    exit 1
fi

DEVICES=()
SIZES=()
while read -r name size; do
    [ "$name" = "loop*" ] && continue
    DEVICES+=("/dev/$name" "$size")
done < <(lsblk -dno NAME,SIZE -e 7,11)

TARGET=$(zenity --list --title="Select Target Disk" \
    --text="Choose the disk to install Sovrn OS onto (all data will be erased):" \
    --column="Device" --column="Size" "${DEVICES[@]}" --width=400 --height=300)

[ -z "$TARGET" ] && exit 1

zenity --question --title="Confirm Install" \
    --text="Install Sovrn OS to $TARGET?\n\nAll data on $TARGET will be DESTROYED." --no-wrap || exit 1

(
    echo "10"; echo "# Partitioning $TARGET..."
    parted -s "$TARGET" mklabel gpt || true
    parted -s "$TARGET" mkpart primary fat32 1MiB 513MiB || true
    parted -s "$TARGET" set 1 esp on || true
    parted -s "$TARGET" mkpart primary ext4 513MiB 100% || true
    sleep 1

    echo "20"; echo "# Formatting partitions..."
    EFI_PART="${TARGET}1"
    ROOT_PART="${TARGET}2"
    [ ! -b "$EFI_PART" ] && EFI_PART="${TARGET}p1"
    [ ! -b "$ROOT_PART" ] && ROOT_PART="${TARGET}p2"
    mkfs.fat -F32 -n SOVRN_EFI "$EFI_PART" >/dev/null 2>&1 || true
    mkfs.ext4 -F -L SOVRN_OS "$ROOT_PART" >/dev/null 2>&1

    echo "30"; echo "# Mounting target..."
    mkdir -p /mnt/sovrn-target
    mount "$ROOT_PART" /mnt/sovrn-target
    mkdir -p /mnt/sovrn-target/boot/efi
    mount "$EFI_PART" /mnt/sovrn-target/boot/efi

    echo "40"; echo "# Copying system files (this may take a while)..."
    rsync -aAXv /* /mnt/sovrn-target \
        --exclude={/proc,/sys,/dev,/run,/mnt,/tmp,/media,/lost+found,/home/*/.gvfs,/var/lib/calamares} \
        --info=progress2 --no-inc-recursive 2>&1 | \
        while IFS= read -r line; do
            if [[ "$line" =~ ([0-9]+)% ]]; then
                pct=$((40 + BASH_REMATCH[1] * 40 / 100))
                echo "$pct"; echo "# Copying: ${BASH_REMATCH[1]}%"
            fi
        done

    echo "80"; echo "# Installing GRUB bootloader..."
    mount --bind /dev /mnt/sovrn-target/dev
    mount --bind /proc /mnt/sovrn-target/proc
    mount --bind /sys /mnt/sovrn-target/sys
    chroot /mnt/sovrn-target /bin/bash -c "
        grub-install --target=i386-pc '$TARGET'
        grub-install --target=x86_64-efi --removable \
            --efi-directory=/boot/efi --boot-directory=/boot --no-nvram || true
        update-grub
    " || true

    echo "90"; echo "# Generating fstab..."
    chroot /mnt/sovrn-target /bin/bash -c "
        cat > /etc/fstab <<FSTAB
LABEL=SOVRN_OS  /          ext4  defaults,errors=remount-ro  0  1
LABEL=SOVRN_EFI /boot/efi  vfat  defaults,noautomount         0  2
tmpfs           /tmp       tmpfs defaults,nosuid,nodev         0  0
FSTAB
    " || true

    echo "95"; echo "# Cleaning up..."
    umount /mnt/sovrn-target/dev /mnt/sovrn-target/proc /mnt/sovrn-target/sys 2>/dev/null || true
    umount /mnt/sovrn-target/boot/efi 2>/dev/null || true
    umount /mnt/sovrn-target 2>/dev/null || true
    rm -rf /mnt/sovrn-target

    echo "100"
) | zenity --progress --title="Installing Sovrn OS" \
    --text="Starting..." --percentage=0 --auto-close --width=400

if [ $? -eq 0 ]; then
    zenity --info --title="Installation Complete" \
        --text="Sovrn OS has been installed to $TARGET.\n\nReboot and boot from the target disk to start using Sovrn OS." --no-wrap
else
    zenity --error --text="Installation failed or was cancelled.\nCheck the target disk and try again."
fi
