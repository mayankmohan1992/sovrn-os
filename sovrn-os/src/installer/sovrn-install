#!/bin/bash
# Sovrn OS Installer — copies the running system to a target disk
# Requires: rsync, parted, grub-install
# Optional: zenity (for GUI mode)
set -euo pipefail

CLI_MODE=0
TARGET=""

# Parse argument
if [ -n "${1:-}" ]; then
    CLI_MODE=1
    TARGET="$1"
    if [ ! -b "$TARGET" ]; then
        echo "Error: $TARGET is not a valid block device." >&2
        exit 1
    fi
fi

# Root check
[ "$(id -u)" -eq 0 ] || {
    if [ "$CLI_MODE" -eq 1 ]; then
        echo "Error: Run this script as root: sudo sovrn-install $TARGET" >&2
    else
        zenity --error --text="Run this as root: sudo sovrn-install"
    fi
    exit 1
}

# Prerequisites check
for cmd in parted rsync grub-install mkfs.ext4 mkfs.fat; do
    command -v "$cmd" >/dev/null 2>&1 || {
        if [ "$CLI_MODE" -eq 1 ]; then
            echo "Error: Missing required command: $cmd" >&2
        else
            zenity --error --text="Missing command: $cmd"
        fi
        exit 1
    }
done

# Confirm and select target if in GUI mode
if [ "$CLI_MODE" -eq 0 ]; then
    command -v zenity >/dev/null 2>&1 || {
        echo "Zenity not found. Running in CLI mode."
        echo "Usage: sudo sovrn-install /dev/sdX"
        exit 1
    }

    if ! zenity --question --title="Sovrn OS Installer" \
        --text="This will DESTROY ALL DATA on the selected disk.\nBack up any important files first.\n\nProceed?" --no-wrap; then
        exit 1
    fi

    DEVICES=()
    while read -r name size; do
        [ "$name" = "loop*" ] && continue
        DEVICES+=("/dev/$name" "$size")
    done < <(lsblk -dno NAME,SIZE -e 7,11)

    TARGET=$(zenity --list --title="Select Target Disk" \
        --text="Choose the disk to install Sovrn OS onto (all data will be erased):" \
        --column="Device" --column="Size" "${DEVICES[@]}" --width=400 --height=300)

    [ -z "$TARGET" ] && exit 1

    zenity --question --title="Confirm Install" \
        --text="Install Sovrn OS to $TARGET?\n\nAll data on $TARGET will be DESTROYED." --no-wrap || exit 1
else
    # CLI confirmation
    echo "WARNING: This will DESTROY ALL DATA on $TARGET!"
    read -p "Are you sure you want to proceed? (y/N): " -r confirm
    if [[ ! "$confirm" =~ ^[yY]$ ]]; then
        echo "Installation cancelled."
        exit 1
    fi
fi

# The installation runner
run_install() {
    echo "10"; echo "# Partitioning $TARGET..."
    parted -s "$TARGET" mklabel gpt || true
    parted -s "$TARGET" mkpart primary 1MiB 2MiB || true
    parted -s "$TARGET" set 1 bios_grub on || true
    parted -s "$TARGET" mkpart primary fat32 2MiB 514MiB || true
    parted -s "$TARGET" set 2 esp on || true
    parted -s "$TARGET" mkpart primary ext4 514MiB 100% || true
    sleep 1

    echo "20"; echo "# Formatting partitions..."
    EFI_PART="${TARGET}2"
    ROOT_PART="${TARGET}3"
    [ ! -b "$EFI_PART" ] && EFI_PART="${TARGET}p2"
    [ ! -b "$ROOT_PART" ] && ROOT_PART="${TARGET}p3"
    mkfs.fat -F32 -n SOVRN_EFI "$EFI_PART" >/dev/null 2>&1 || true
    mkfs.ext4 -F -L SOVRN_OS "$ROOT_PART" >/dev/null 2>&1

    echo "30"; echo "# Mounting target..."
    mkdir -p /mnt/sovrn-target
    mount "$ROOT_PART" /mnt/sovrn-target
    mkdir -p /mnt/sovrn-target/boot/efi
    mount "$EFI_PART" /mnt/sovrn-target/boot/efi

    echo "40"; echo "# Copying system files (this may take a while)..."
    rsync -aAXv /* /mnt/sovrn-target \
        --exclude={/proc,/sys,/dev,/run,/mnt,/tmp,/media,/lost+found,/home/*/.gvfs,/var/lib/calamares} \
        --info=progress2 --no-inc-recursive 2>&1 | \
        while IFS= read -r line; do
            if [[ "$line" =~ ([0-9]+)% ]]; then
                pct=$((40 + BASH_REMATCH[1] * 40 / 100))
                echo "$pct"; echo "# Copying: ${BASH_REMATCH[1]}%"
            fi
        done

    echo "80"; echo "# Installing GRUB bootloader..."
    mkdir -p /mnt/sovrn-target/{dev,proc,sys,run,mnt,tmp,media}
    chmod 1777 /mnt/sovrn-target/tmp
    mount --bind /dev /mnt/sovrn-target/dev
    mount --bind /proc /mnt/sovrn-target/proc
    mount --bind /sys /mnt/sovrn-target/sys

    # Attempt to mount efivarfs in case we need EFI variable registration, but we will also install fallback removable EFI
    mkdir -p /mnt/sovrn-target/sys/firmware/efi/efivars
    mount -t efivarfs efivarfs /mnt/sovrn-target/sys/firmware/efi/efivars 2>/dev/null || true

    # Install both UEFI and Legacy BIOS GRUB configurations to target disk for maximum compatibility
    echo "[Info] Installing Legacy BIOS bootloader to $TARGET..."
    chroot /mnt/sovrn-target grub-install --target=i386-pc "$TARGET" || echo "Warning: Legacy BIOS bootloader installation failed"

    echo "[Info] Installing UEFI bootloader..."
    chroot /mnt/sovrn-target grub-install --target=x86_64-efi --efi-directory=/boot/efi --boot-directory=/boot --no-nvram --removable || echo "Warning: UEFI bootloader installation failed"

    chroot /mnt/sovrn-target update-grub

    echo "90"; echo "# Generating fstab..."
    chroot /mnt/sovrn-target /bin/bash -c "
        cat > /etc/fstab <<FSTAB
LABEL=SOVRN_OS  /          ext4  defaults,errors=remount-ro  0  1
LABEL=SOVRN_EFI /boot/efi  vfat  defaults,nofail              0  2
tmpfs           /tmp       tmpfs defaults,nosuid,nodev         0  0
FSTAB
    " || true

    echo "92"; echo "# Removing installer application options from installed system..."
    # Run inside chroot to purge calamares package
    chroot /mnt/sovrn-target /bin/bash -c "DEBIAN_FRONTEND=noninteractive apt-get purge -y calamares >/dev/null 2>&1" || true
    chroot /mnt/sovrn-target /bin/bash -c "DEBIAN_FRONTEND=noninteractive apt-get autoremove -y >/dev/null 2>&1" || true
    
    # Explicitly delete the desktop files and script files directly from the mount point, ensuring they are gone!
    rm -f /mnt/sovrn-target/usr/share/applications/sovrn-install.desktop
    rm -f /mnt/sovrn-target/usr/share/applications/*calamares*.desktop
    rm -f /mnt/sovrn-target/usr/share/applications/io.calamares.calamares.desktop
    rm -f /mnt/sovrn-target/usr/bin/sovrn-install
    
    # Reset OOBE setup status for the installed system so they can do a fresh setup on boot
    rm -f /mnt/sovrn-target/var/lib/sovrn/oobe-complete
    rm -f /mnt/sovrn-target/var/lib/sovrn/setup-complete

    echo "95"; echo "# Cleaning up..."
    umount /mnt/sovrn-target/sys/firmware/efi/efivars 2>/dev/null || true
    umount /mnt/sovrn-target/dev /mnt/sovrn-target/proc /mnt/sovrn-target/sys 2>/dev/null || true
    umount /mnt/sovrn-target/boot/efi 2>/dev/null || true
    umount /mnt/sovrn-target 2>/dev/null || true
    rm -rf /mnt/sovrn-target

    echo "100"
}

if [ "$CLI_MODE" -eq 1 ]; then
    run_install | while read -r line; do
        if [[ "$line" =~ ^#\ (.*) ]]; then
            echo "[Progress] ${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^[0-9]+$ ]]; then
            echo "[Percent] ${line}%"
        fi
    done
    echo "Installation completed successfully!"
else
    if run_install | zenity --progress --title="Installing Sovrn OS" \
        --text="Starting..." --percentage=0 --auto-close --width=400; then
        zenity --info --title="Installation Complete" \
            --text="Sovrn OS has been installed to $TARGET.\n\nReboot and boot from the target disk to start using Sovrn OS." --no-wrap
    else
        zenity --error --text="Installation failed or was cancelled.\nCheck the target disk and try again."
    fi
fi
