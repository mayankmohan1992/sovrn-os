#!/bin/bash
# Pre-remove script for sovrn-os metapackage
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop all sovrn services
        systemctl stop sovrn.target 2>/dev/null || true
        systemctl stop sovrn-oobe.service 2>/dev/null || true
        ;;
    failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        ;;
esac

exit 0
